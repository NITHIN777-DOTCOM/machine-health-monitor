{
  "description": "Simulator baselines and fault scenarios. Phase 8.2: the normal baselines follow the real bench (session 01 normal rows: vibration mostly 0, sound 3-4, ~78 %RH, distance ~154 cm; the DHT11 barely changes within seconds, so temperature/humidity have no fast noise), so the real-data model sees simulated normal as normal. Sensor keys must match backend/config/sensors.json.",
  "tick_seconds": 1.0,
  "sensors": {
    "temp_c":      {"mean": 29.9,  "wander": 0.4,  "wander_period_s": 1200, "noise": 0.0,  "min": 29.3, "max": 31.3,  "physical_min": 0,   "physical_max": 50,   "decimals": 1},
    "humidity":    {"mean": 78.0,  "wander": 1.5,  "wander_period_s": 1500, "noise": 0.0,  "min": 72.0, "max": 80.0,  "physical_min": 20,  "physical_max": 90,   "decimals": 0},
    "sound_peak":  {"mean": 3.4,   "wander": 0.0,  "wander_period_s": 120,  "noise": 0.3,  "min": 3,    "max": 5,     "physical_min": 0,   "physical_max": 1023, "decimals": 0},
    "vib_count":   {"mean": 0.0,   "wander": 0.0,  "wander_period_s": 90,   "noise": 0.25, "min": 0,    "max": 3,     "physical_min": 0,   "physical_max": 1000, "decimals": 0},
    "leak_raw":    {"mean": 5.5,   "wander": 0.5,  "wander_period_s": 300,  "noise": 1.1,  "min": 3,    "max": 8,     "physical_min": 0,   "physical_max": 1023, "decimals": 0},
    "distance_cm": {"mean": 154.0, "wander": 3.0,  "wander_period_s": 600,  "noise": 0.4,  "min": 147.0, "max": 158.0, "physical_min": 2,   "physical_max": 400,  "decimals": 1},
    "current_ma":  {"mean": 180.0, "wander": 5.0,  "wander_period_s": 300, "noise": 2.0,  "min": 170,  "max": 190,   "physical_min": 0,   "physical_max": 3200, "decimals": 1},
    "bus_v":       {"mean": 4.98,  "wander": 0.02, "wander_period_s": 300, "noise": 0.01, "min": 4.9,  "max": 5.05,  "physical_min": 0,   "physical_max": 26,   "decimals": 2}
  },
  "scenarios": {
    "normal": {
      "description": "Healthy machine, baseline values only.",
      "effects": {}
    },
    "sudden_fault": {
      "description": "Step jump in vibration and sound at a random time 20-60 s in.",
      "start_s": [20, 60],
      "label_after_start": "fault",
      "effects": {
        "vib_count":  {"add": 130, "noise": 25},
        "sound_peak": {"add": 120, "noise": 40}
      }
    },
    "slow_drift": {
      "description": "Temperature rises by +6 C over 240 s (~29.5 -> ~35.5 C, crossing 32 then 35); vibration slowly rises.",
      "start_s": [10, 10],
      "ramp_s": 240,
      "label_after_start": "fault",
      "effects": {
        "temp_c":    {"ramp_add": 6.0, "steady": true},
        "vib_count": {"ramp_add": 30, "noise": 4}
      }
    },
    "sensor_fault": {
      "description": "DHT11 stops responding partway through: temp_c and humidity go empty.",
      "start_s": [20, 60],
      "label_after_start": "unknown",
      "effects": {
        "temp_c":   {"empty": true},
        "humidity": {"empty": true}
      }
    },
    "recovery": {
      "description": "Normal for 20 s, then vibration and sound jump past critical for 30 s, then return to normal (CRITICAL -> WARNING -> NORMAL via the hold time).",
      "start_s": [20, 20],
      "duration_s": 30,
      "label_after_start": "fault",
      "effects": {
        "vib_count":  {"add": 140, "noise": 10},
        "sound_peak": {"add": 150, "noise": 15}
      }
    },
    "drift_and_recover": {
      "description": "Temperature drifts up +7 C over 120 s (past 32 and 35), stays hot for 60 s, then cools back to baseline over 120 s.",
      "start_s": [10, 10],
      "ramp_s": 120,
      "duration_s": 180,
      "recover_s": 120,
      "label_after_start": "fault",
      "effects": {
        "temp_c":    {"ramp_add": 7.0, "steady": true},
        "vib_count": {"ramp_add": 15, "noise": 3}
      }
    }
  }
}
