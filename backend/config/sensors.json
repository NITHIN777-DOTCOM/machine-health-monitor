{
  "schema_version": 2,
  "description": "Sensor registry. The backend, ML pipeline and dashboard read the sensor list from this file; the firmware limits are generated from it (backend/scripts/gen_firmware_config.py). See docs/DATA_CONTRACT.md.",
  "csv_columns": [
    "ms",
    "temp_c",
    "humidity",
    "sound_peak",
    "vib_count",
    "leak_raw",
    "distance_cm",
    "current_ma",
    "bus_v",
    "dev_state"
  ],
  "sensors": [
    {
      "key": "temp_c",
      "display_name": "Temperature",
      "unit": "°C",
      "hardware": "DHT11",
      "pin": "A0",
      "warn": 32,
      "critical": 35,
      "direction": "above",
      "hysteresis": 0.5,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": true,
      "firmware_flag": "USE_DHT11",
      "lcd_name": "TMP"
    },
    {
      "key": "humidity",
      "display_name": "Humidity",
      "unit": "%RH",
      "hardware": "DHT11",
      "pin": "A0",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": false,
      "firmware_flag": "USE_DHT11",
      "lcd_name": "HUM",
      "comment": "No rule limits: humidity is not a machine-fault signal, room humidity in Chennai sits around 80 %RH and the DHT11 tops out at 90 %RH. Still shown and used by ML."
    },
    {
      "key": "sound_peak",
      "display_name": "Sound level (peak deviation)",
      "unit": "counts",
      "hardware": "Sound module (analog out)",
      "pin": "A2",
      "warn": 40,
      "critical": 120,
      "direction": "above",
      "hysteresis": 10,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": false,
      "firmware_flag": "USE_SOUND",
      "lcd_name": "SND"
    },
    {
      "key": "vib_count",
      "display_name": "Vibration",
      "unit": "edges/s",
      "hardware": "SW-420 (HW-072)",
      "pin": "D2",
      "warn": 50,
      "critical": 100,
      "direction": "above",
      "hysteresis": 10,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": false,
      "firmware_flag": "USE_VIBRATION",
      "lcd_name": "VIB"
    },
    {
      "key": "leak_raw",
      "display_name": "Water leak",
      "unit": "counts",
      "hardware": "Water leak sensor (analog)",
      "pin": "A1",
      "warn": 50,
      "critical": 200,
      "direction": "above",
      "hysteresis": 20,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "optional",
      "enabled": true,
      "include_in_ml": false,
      "forecast": false,
      "firmware_flag": "USE_LEAK",
      "lcd_name": "LEAK",
      "comment": "Rule-based event, not an ML feature (adding it would also need a retrain). Dry 4-9, wet 240-576 (bench test 2026-10-23)."
    },
    {
      "key": "distance_cm",
      "display_name": "Safety zone (distance)",
      "unit": "cm",
      "hardware": "HC-SR04",
      "pin": "D9 (Trig) / D10 (Echo)",
      "warn": 20,
      "critical": 10,
      "direction": "below",
      "hysteresis": 3,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "optional",
      "enabled": true,
      "include_in_ml": false,
      "forecast": false,
      "out_of_range_value": 400,
      "firmware_flag": "USE_HCSR04",
      "lcd_name": "DIST",
      "comment": "Safety zone: a person or object too close to the running machine. 400 = no echo, nothing in range (clear); an empty field is a sensor fault."
    },
    {
      "key": "current_ma",
      "display_name": "Current",
      "unit": "mA",
      "hardware": "INA219 (I2C 0x40)",
      "pin": "A4 (SDA) / A5 (SCL)",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "optional",
      "enabled": false,
      "include_in_ml": false,
      "forecast": false,
      "firmware_flag": "USE_INA219",
      "lcd_name": "CUR",
      "group": "ina219"
    },
    {
      "key": "bus_v",
      "display_name": "Bus voltage",
      "unit": "V",
      "hardware": "INA219 (I2C 0x40)",
      "pin": "A4 (SDA) / A5 (SCL)",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "optional",
      "enabled": false,
      "include_in_ml": false,
      "forecast": false,
      "firmware_flag": "USE_INA219",
      "lcd_name": "VBUS",
      "group": "ina219"
    }
  ]
}
