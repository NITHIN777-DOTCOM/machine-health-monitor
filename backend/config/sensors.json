{
  "schema_version": 2,
  "description": "Sensor registry. The backend, ML pipeline and dashboard read the sensor list from this file. See docs/DATA_CONTRACT.md.",
  "csv_columns": [
    "ms",
    "temp_c",
    "humidity",
    "sound_peak",
    "vib_count",
    "leak_raw",
    "distance_cm",
    "current_ma",
    "bus_v",
    "dev_state"
  ],
  "sensors": [
    {
      "key": "temp_c",
      "display_name": "Temperature",
      "unit": "°C",
      "hardware": "DHT11",
      "pin": "A0",
      "warn": 32,
      "critical": 35,
      "direction": "above",
      "hysteresis": 0.5,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": true
    },
    {
      "key": "humidity",
      "display_name": "Humidity",
      "unit": "%RH",
      "hardware": "DHT11",
      "pin": "A0",
      "warn": 80,
      "critical": 90,
      "direction": "above",
      "hysteresis": 3,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": true
    },
    {
      "key": "sound_peak",
      "display_name": "Sound level (peak deviation)",
      "unit": "counts",
      "hardware": "Sound module (analog out)",
      "pin": "A2",
      "warn": 40,
      "critical": 120,
      "direction": "above",
      "hysteresis": 10,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": false
    },
    {
      "key": "vib_count",
      "display_name": "Vibration",
      "unit": "edges/s",
      "hardware": "SW-420 (HW-072)",
      "pin": "D2",
      "warn": 20,
      "critical": 60,
      "direction": "above",
      "hysteresis": 5,
      "limits_note": "provisional demo limit - retune from real data in Phase 8",
      "tier": "core",
      "enabled": true,
      "include_in_ml": true,
      "forecast": false
    },
    {
      "key": "leak_raw",
      "display_name": "Water leak",
      "unit": "counts",
      "hardware": "Water leak sensor (analog)",
      "pin": "A1",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "optional",
      "enabled": false,
      "include_in_ml": true,
      "forecast": false
    },
    {
      "key": "distance_cm",
      "display_name": "Distance",
      "unit": "cm",
      "hardware": "HC-SR04",
      "pin": "D9 (Trig) / D10 (Echo)",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "optional",
      "enabled": false,
      "include_in_ml": true,
      "forecast": false,
      "comment": "direction TBD: may need to be \"below\" (object too close) once limits are chosen"
    },
    {
      "key": "current_ma",
      "display_name": "Current",
      "unit": "mA",
      "hardware": "INA219 (I2C 0x40)",
      "pin": "A4 (SDA) / A5 (SCL)",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "optional",
      "enabled": false,
      "include_in_ml": false,
      "forecast": false,
      "group": "ina219"
    },
    {
      "key": "bus_v",
      "display_name": "Bus voltage",
      "unit": "V",
      "hardware": "INA219 (I2C 0x40)",
      "pin": "A4 (SDA) / A5 (SCL)",
      "warn": null,
      "critical": null,
      "direction": "above",
      "hysteresis": null,
      "tier": "optional",
      "enabled": false,
      "include_in_ml": false,
      "forecast": false,
      "group": "ina219"
    }
  ]
}
